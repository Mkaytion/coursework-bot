# Copy to .env and fill in yourself. Put real values in .env, NOT in this file.
DISCORD_TOKEN=
GUILD_ID=
CHANNEL_ID=            # channel for the Monday 08:00 auto-post

# MyCourses mobile web-service token (~3 months). Preferred auth. See README
# "MyCourses auth"; capture with launch.php + ws-token.mjs.
MOODLE_WS_TOKEN=

# Fallback only: the browser session cookie, used when MOODLE_WS_TOKEN is unset.
# Expires every few days. DevTools > Application > Cookies > mycourses.aalto.fi.
MOODLE_SESSION=

# A+ (plus.cs.aalto.fi) — Aalto CS exercises. Permanent, does not expire.
# Get it from https://plus.cs.aalto.fi/api/v2/get-token/ while logged in.
APLUS_TOKEN=

# Optional. The bot already limits itself to THIS PERIOD's courses.
# Set only to narrow further, e.g. COURSE_FILTER=COE-C2003
COURSE_FILTER=

# Which week the Monday 08:00 post covers. 0 = week just starting, -1 = recap.
WEEKLY_POST_OFFSET=0

# Daily change check: hour of day (0-23) and how many weeks ahead to scan.
DAILY_HOUR=18
SCAN_WEEKS=4
